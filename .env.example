# ─── Ollama Configuration ─────────────────────────────────────────────────────
# URL where Ollama is running
OLLAMA_BASE_URL=http://localhost:11434

# Model to use (must be pulled first: ollama pull llama3)
# Options: llama3, llama3:8b, mistral, mistral:7b, qwen2, qwen2:7b, phi3
OLLAMA_MODEL=llama3

# Embedding model for Ollama (optional, falls back to sentence-transformers)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Memory / Storage ─────────────────────────────────────────────────────────
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# ChromaDB collection name
CHROMA_COLLECTION_NAME=assistant_memory

# Conversation history directory
CONVERSATIONS_DIR=./conversations

# ─── Search ───────────────────────────────────────────────────────────────────
# Max DuckDuckGo results per search
MAX_SEARCH_RESULTS=5

# Max characters to extract from a scraped webpage
MAX_SCRAPE_LENGTH=4000

# ─── API ──────────────────────────────────────────────────────────────────────
# FastAPI host and port
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8501

# ─── Safety ───────────────────────────────────────────────────────────────────
# Max seconds for code execution
CODE_EXECUTION_TIMEOUT=10

# Max tokens to include from conversation history
MAX_HISTORY_TOKENS=4000
